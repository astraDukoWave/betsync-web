# ============================================
# BetSync Web — Variables de Entorno
# ============================================
# Copia este archivo a .env.local y ajusta los valores:
#   cp .env.example .env.local

# ----- Backend FastAPI -----
# URL base del API de BetSync (sin trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ----- Pipeline -----
# Intervalo de polling en milisegundos (default: 2000)
NEXT_PUBLIC_POLLING_INTERVAL_MS=2000

# Timeout máximo del pipeline en milisegundos (default: 60000 = 1 min)
NEXT_PUBLIC_PIPELINE_TIMEOUT_MS=60000

# ----- Entorno -----
# "development" | "production" | "test"
NODE_ENV=development
NEXT_PUBLIC_USE_FINANCIAL_MOCKS=true
NEXT_PUBLIC_RECONCILIATION_SECRET=supersecret_gameday6
